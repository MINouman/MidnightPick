NODE_ENV=production
PORT=3000
# Your production domain — must match the domain users access the site on
CORS_ORIGIN=https://yourdomain.com
# Number of proxy hops in front of the app (nginx = 1). Do NOT raise this beyond
# your actual proxy count or clients can spoof X-Forwarded-For to bypass rate limits.
TRUST_PROXY=1

# PostgreSQL — use pgBouncer in production, change credentials
# Run: ALTER USER midnight_user WITH PASSWORD '<strong-random-password>';
DATABASE_URL=postgresql://midnight_user:<strong-random-password>@localhost:5432/midnightpick_db

# Redis
REDIS_URL=redis://127.0.0.1:6379

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Both must be different, at least 48 bytes of entropy each
JWT_SECRET=<generate-with-command-above>
JWT_REFRESH_SECRET=<generate-with-command-above-different-value>

# Google OAuth (same client ID as dev — it's not a secret)
GOOGLE_CLIENT_ID=441978018594-rgubekigfvjlpp62utifk2bj6or5hfrq.apps.googleusercontent.com

# OTP settings
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW=600
OTP_RATE_LIMIT_MAX=3

# SMS Gateway (BulkSMSBD) — production credentials
SMS_API_URL=http://bulksmsbd.net/api/smsapi
SMS_API_KEY=<your-production-sms-api-key>
SMS_SENDER_ID=<your-approved-sender-id>
SMS_BALANCE_API_URL=http://bulksmsbd.net/api/getBalanceApi
SMS_RATE_LIMIT_OTP_GLOBAL=3
SMS_RATE_LIMIT_OTP_DEVICE=5
SMS_RATE_LIMIT_GENERAL=10

# Steadfast Delivery Integration
STEADFAST_API_KEY=<your-production-steadfast-api-key>
STEADFAST_SECRET_KEY=<your-production-steadfast-secret>
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STEADFAST_WEBHOOK_BEARER_TOKEN=<generate-with-command-above>
# MUST be false in production — enables SSL cert validation
STEADFAST_INSECURE=false
